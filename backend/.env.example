# LLM provider: gemini | openrouter
LLM_PROVIDER=gemini

# Gemini (Google AI Studio) — required when LLM_PROVIDER=gemini
GEMINI_API_KEY=GEMINI_API_KEY_HERE
GEMINI_MODEL=gemini-3.5-flash-lite

# OpenRouter - required when LLM_PROVIDER=openrouter
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_MODEL=google/gemini-2.0-flash-001

# Directory containing CV PDFs (relative to backend/ or absolute)
DATA_DIR=../data

# ChromaDB persistent storage directory
CHROMA_DIR=./chroma_data

# Sentence-transformers embedding model (local, free)
EMBEDDING_MODEL=all-MiniLM-L6-v2

# Text chunking
CHUNK_SIZE=800
CHUNK_OVERLAP=100

# Number of chunks to retrieve per query
RETRIEVAL_TOP_K=5

# Comma-separated CORS origins
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
